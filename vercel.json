{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/openapi.json",
      "destination": "/api/report?view=openapi"
    },
    {
      "source": "/api/report/exercise",
      "destination": "/api/report?view=exercise"
    },
    {
      "source": "/api/report/export",
      "destination": "/api/report?view=export"
    },
    {
      "source": "/live/:stamp/progress.txt",
      "destination": "/api/progress?format=md"
    },
    {
      "source": "/live/:stamp/progress.json",
      "destination": "/api/progress?format=json"
    },
    {
      "source": "/live/:stamp/export.json",
      "destination": "/api/progress?format=json&view=export"
    },
    {
      "source": "/live/:stamp",
      "destination": "/api/progress?format=html"
    },
    {
      "source": "/progress",
      "destination": "/api/progress?format=html"
    },
    {
      "source": "/progress.txt",
      "destination": "/api/progress?format=md"
    }
  ]
}
